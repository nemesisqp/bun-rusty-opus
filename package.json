{
  "author": "Phuong Nhu DQ",
  "bugs": {
    "url": "https://github.com/nemesisqp/bun-rusty-opus/issues"
  },
  "description": "Bun/Node bindings to rusty-opus \u2014 a pure-Rust Opus codec, faster to encode than libopus. Drop-in replacement for @discordjs/opus.",
  "devDependencies": {
    "@discordjs/opus": "^0.11.0",
    "@napi-rs/cli": "^3.10.12",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.0"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "binding.js",
    "lib/",
    "scripts/check-prebuilt.js",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "homepage": "https://github.com/nemesisqp/bun-rusty-opus",
  "keywords": [
    "opus",
    "audio",
    "codec",
    "bun",
    "napi",
    "rust",
    "discord",
    "voice"
  ],
  "license": "MIT",
  "main": "index.js",
  "name": "bun-rusty-opus",
  "napi": {
    "binaryName": "bun-rusty-opus",
    "packageName": "bun-rusty-opus",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nemesisqp/bun-rusty-opus.git"
  },
  "scripts": {
    "bench": "bun bench/bench.mjs",
    "build": "napi build --platform --release --js binding.js --dts lib/binding.d.ts",
    "build:debug": "napi build --platform --js binding.js --dts lib/binding.d.ts",
    "build:local": "bash scripts/build-local.sh",
    "clippy": "cargo clippy --all-targets -- -D warnings",
    "fmt": "cargo fmt --check",
    "fmt:fix": "cargo fmt",
    "postinstall": "node scripts/check-prebuilt.js",
    "release:prepare": "napi create-npm-dirs && napi prepublish",
    "test": "node --test test/*.test.mjs",
    "test:bun": "bun test test/",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "types": "index.d.ts",
  "version": "0.1.1"
}
